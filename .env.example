# ============================================
# Buy Me a Coffee — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.

# ------ Razorpay ------
# Get these from https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Webhook secret — set this in Razorpay Dashboard → Webhooks
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ------ Supabase ------
# Get these from https://supabase.com → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxx

# ------ App Config ------
# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Backend port
PORT=5000
